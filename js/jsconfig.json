{
  "_comment": "checkJs turns tsc into a type-checker for plain .js (with JSDoc). Run via: tsc --noEmit -p jsconfig.json. The kit's own lint plugin is excluded: it is CommonJS lint-rule code, not your app.",
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src", "apps", "packages"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".next",
    "packages/eslint-plugin"
  ]
}
