# build-hardening-kit Make targets (kept current by `copier update`).
# Your Makefile includes this file. `make check` is the local gate; CI runs it.
# `make fmt` rewrites files; `make check` only reports.
.PHONY: fmt fmt-check lint vet test build check

fmt:
	golangci-lint fmt

fmt-check:
	golangci-lint fmt --diff

# Only issues new since origin/[[ default_branch ]] fail; CI reports the rest on [[ default_branch ]].
# The base for "only new issues". Without an origin/[[ default_branch ]] (a repo
# with no remote yet) every issue counts as new.
LINT_BASE ?= $(shell git rev-parse --verify --quiet origin/[[ default_branch ]] >/dev/null 2>&1 && echo origin/[[ default_branch ]])

lint:
	golangci-lint run $(if $(LINT_BASE),--new-from-rev=$(LINT_BASE))

vet:
	go vet ./...

test:
	go test -race ./...

# Compiles everything without leaving a binary in the repository.
build:
	go build -o /dev/null ./...

# CHECK_LINT= leaves lint out of `make check` (CI does that on the default
# branch, where it reports lint debt separately without failing).
CHECK_LINT ?=[% if 'lint' in modules %] lint[% endif +%]

check:[% if 'format' in modules %] fmt-check[% endif %] $(CHECK_LINT) vet build
