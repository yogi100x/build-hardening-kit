#!/usr/bin/env bash
# Make the hardening checks block merges into [[ default_branch ]] (GitHub branch
# protection). Created by build-hardening-kit; kept current by `copier update`,
# so the required checks always match the jobs your workflows really run.
#
# Usage:  .github/hardening/protect-branch.sh [--dry-run] [--replace] [owner/repo]
#   --dry-run  print the settings and change nothing
#   --replace  allow dropping required checks that are set today but are not
#              the kit's (by default the script stops and lists them)
# Needs:  gh, signed in with admin rights on the repo. Branch protection on a
#         private repo needs a paid GitHub plan; public repos are free.
set -euo pipefail

dry_run=0
replace=0
repo=""
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=1 ;;
    --replace) replace=1 ;;
    -h | --help)
      sed -n '2,11p' "$0"
      exit 0
      ;;
    -*)
      echo "unknown option: $arg (see --help)" >&2
      exit 2
      ;;
    *)
      if [ -n "$repo" ]; then
        echo "more than one repository given: $repo, $arg" >&2
        exit 2
      fi
      repo="$arg"
      ;;
  esac
done

branch="[[ default_branch ]]"

# Every check below must pass before a pull request can merge. A required check
# that never runs blocks merging forever, so this list is generated from the
# jobs the kit put in .github/workflows/.
checks=([% for c in required_checks %]"[[ c ]]"[% if not loop.last %] [% endif %][% endfor %])

payload=$(cat <<'JSON'
{
  "required_status_checks": {
    "strict": false,
    "contexts": [[ required_checks | tojson ]]
  },
  "enforce_admins": true,
  "required_pull_request_reviews": {
    "required_approving_review_count": [[ required_reviews ]],
    "require_code_owner_reviews": [[ 'true' if code_owners and required_reviews > 0 else 'false' ]],
    "dismiss_stale_reviews": true
  },
  "required_conversation_resolution": true,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "restrictions": null
}
JSON
)

if [ "$dry_run" = 1 ]; then
  printf '%s\n' "$payload"
  exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "The GitHub CLI (gh) is needed: https://cli.github.com, then: gh auth login" >&2
  exit 1
fi
if [ -z "$repo" ]; then
  repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
fi

# This call replaces the branch's whole protection. Required checks set today
# that are not the kit's would be dropped: stop and list them unless --replace.
existing="$(gh api "repos/$repo/branches/$branch/protection/required_status_checks" \
  --jq '.contexts[]' 2>/dev/null || true)"
dropped=()
while IFS= read -r ctx; do
  [ -z "$ctx" ] && continue
  keep=0
  for c in "${checks[@]}"; do [ "$c" = "$ctx" ] && keep=1; done
  [ "$keep" = 0 ] && dropped+=("$ctx")
done <<<"$existing"
if [ "${#dropped[@]}" -gt 0 ] && [ "$replace" = 0 ]; then
  echo "These required checks are set on $repo@$branch today and would be dropped:" >&2
  printf '  - %s\n' "${dropped[@]}" >&2
  echo "Add them to the kit's list by hand afterwards, or re-run with --replace." >&2
  exit 1
fi

printf '%s\n' "$payload" | gh api -X PUT "repos/$repo/branches/$branch/protection" \
  -H "Accept: application/vnd.github+json" --input - >/dev/null
echo "Protected $repo@$branch: [[ required_checks | join(', ') ]] must pass; [[ required_reviews ]] approving review(s)."
