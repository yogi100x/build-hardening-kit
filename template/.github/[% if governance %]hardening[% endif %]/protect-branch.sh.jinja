#!/usr/bin/env bash
# Make the hardening checks block merges into [[ default_branch ]] (GitHub branch
# protection). Created by build-hardening-kit; kept current by `copier update`,
# so the required checks always match the jobs your workflows really run.
#
# Usage:  .github/hardening/protect-branch.sh [--dry-run] [owner/repo]
# Needs:  gh, signed in with admin rights on the repo. Branch protection on a
#         private repo needs a paid GitHub plan; public repos are free.
# --dry-run prints the settings and changes nothing.
set -euo pipefail

dry_run=0
if [ "${1:-}" = "--dry-run" ]; then
  dry_run=1
  shift
fi

branch="[[ default_branch ]]"

# Every check below must pass before a pull request can merge. A required check
# that never runs blocks merging forever, so this list is generated from the
# jobs the kit put in .github/workflows/.
payload=$(cat <<'JSON'
{
  "required_status_checks": {
    "strict": false,
    "contexts": [[ required_checks | tojson ]]
  },
  "enforce_admins": true,
  "required_pull_request_reviews": {
    "required_approving_review_count": [[ required_reviews ]],
    "require_code_owner_reviews": [[ 'true' if code_owners and required_reviews > 0 else 'false' ]],
    "dismiss_stale_reviews": true
  },
  "required_conversation_resolution": true,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "restrictions": null
}
JSON
)

if [ "$dry_run" = 1 ]; then
  printf '%s\n' "$payload"
  exit 0
fi

repo="${1:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}"
printf '%s\n' "$payload" | gh api -X PUT "repos/$repo/branches/$branch/protection" \
  -H "Accept: application/vnd.github+json" --input - >/dev/null
echo "Protected $repo@$branch: [[ required_checks | join(', ') ]] must pass; [[ required_reviews ]] approving review(s)."
