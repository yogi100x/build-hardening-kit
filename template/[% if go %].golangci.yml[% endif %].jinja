# golangci-lint v2 config (build-hardening-kit; kept current by `copier update`).
# golangci-lint bundles 50+ linters and the formatters, so `golangci-lint run` is
# Go's lint + format gate in one binary.
version: "2"

run:
  timeout: 5m

linters:
  default: standard # errcheck, govet, ineffassign, staticcheck, unused
  enable:
    - revive # style (golint successor)
    - gosec # security scanner
    - gocritic # opinionated checks[% if go_arch %] + the ruleguard host for hardening_rules.go[% endif +%]
    - bodyclose # unclosed HTTP bodies
    - rowserrcheck # unchecked sql.Rows.Err
    - sqlclosecheck # unclosed sql.Rows/Stmt
    - errorlint # wrong error wrapping
    - nilerr # returning nil after err check
    - misspell
  exclusions:
    rules:
      # A package comment on `package main` adds little; keep the rule elsewhere.
      - path: (^|/)main\.go$
        linters: [revive]
        text: package-comments
  settings:
    govet:
      enable-all: true
    gocritic:
      enabled-tags: [diagnostic, performance, style]
[% if go_arch %]
      settings:
        ruleguard:
          rules: "${base-path}/hardening_rules.go"
[% endif %]

formatters:
  enable:
    - gofmt
    - gci # deterministic import order
  settings:
    gci:
      sections:
        - standard
        - default
[% if go_module %]
        - prefix([[ go_module ]])
[% endif %]

issues:
  max-issues-per-linter: 0
  max-same-issues: 0
  # The ratchet (only new issues fail) is applied where lint runs: `make lint`
  # passes --new-from-rev=origin/[[ default_branch ]] when that ref exists; CI
  # runs `make check` on pull requests and reports all issues without failing
  # on [[ default_branch ]].

severity:
  default: error
