# Merge into your Makefile. `make check` is the local gate; CI runs the same steps.
# `make fmt` rewrites files; `make check` only reports (never writes).
.PHONY: fmt fmt-check lint vet test build check

fmt:
	golangci-lint fmt

fmt-check:
	golangci-lint fmt --diff

# Only issues new since origin/main fail; existing debt is reported in CI on main.
lint:
	golangci-lint run --new-from-rev=origin/main

vet:
	go vet ./...

test:
	go test -race -covermode=atomic ./...

build:
	go build ./...

check: fmt-check lint vet test build
