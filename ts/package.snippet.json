{
  "_comment": "Merge these fields into your root package.json. Adjust the plugin path if not packages/eslint-plugin.",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "typecheck": "tsc --noEmit",
    "baseline:generate": "node packages/eslint-plugin/scripts/generate-baseline.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": ["eslint --fix --max-warnings=0"],
    "**/*.{ts,tsx,json,md,css}": ["prettier --write"]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "typescript": "^5.7.2",
    "prettier": "^3.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
